# Copy to .env and fill in real values. Never commit .env.

# OpenRouter API key (used in Part 8/9 for AI calls).
# Get a free key at https://openrouter.ai/keys (no credit card required for
# :free-tier models). The default model in backend/app/ai.py is a free OSS one.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model id. Defaults to openai/gpt-oss-120b:free
# (free tier, rate-limited). For higher quality and structured output guarantees
# pick a paid model like openai/gpt-4o-mini or openai/gpt-oss-120b (no :free).
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Secret used by Starlette SessionMiddleware to sign the session cookie.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Set to 1 to enable CORS for the Next.js dev server on http://localhost:3000.
# Leave at 0 in container mode (frontend is served same-origin).
DEV_MODE=0
